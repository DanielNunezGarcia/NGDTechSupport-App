<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_soft_blue"
    android:padding="16dp">

    <!-- Cabecera -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Panel de Soporte Técnico"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/dashboard_header"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvUserInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_card"
        android:padding="16dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rol:"
        android:textSize="14sp"
        android:textColor="@color/text_sender"
        android:paddingBottom="12dp" />

    <!-- Botones principales -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnChat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/cd_dashboard_chat"
            android:text="Chat"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/surface_white" />

        <Button
            android:id="@+id/btnUpdates"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/cd_dashboard_updates"
            android:text="Updates"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/dashboard_header" />

        <Button
            android:id="@+id/btnChannels"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/cd_dashboard_channels"
            android:text="Canales"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/dashboard_header" />
    </LinearLayout>

    <!-- Botón Config IA (solo para ADMIN) -->
    <Button
        android:id="@+id/btnAiConfig"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:contentDescription="@string/cd_dashboard_ai_config"
        android:text="Configuración IA"
        android:textAllCaps="false"
        android:background="@drawable/bg_button_secondary"
        android:textColor="@color/dashboard_header"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:contentDescription="@string/cd_dashboard_logout"
        android:text="Cerrar sesión"
        android:textAllCaps="false"
        android:background="@drawable/bg_button_tertiary"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <!-- Texto que usas ahora mismo para mostrar las apps -->
    <TextView
        android:id="@+id/tvApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cargando..."
        android:background="@drawable/bg_surface_card"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_surface_card">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <include
            android:id="@+id/skeletonDashboard"
            layout="@layout/view_skeleton_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <Button
        android:id="@+id/btnCreatePrivateChannel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/cd_dashboard_create_private_channel"
        android:text="Crear Canal Privado"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:textColor="@color/surface_white"
        android:layout_marginTop="8dp"/>

</LinearLayout>
