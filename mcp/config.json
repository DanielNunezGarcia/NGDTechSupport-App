{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-filesystem", "D:/Proyectos/APP/NGDStudios/NGD_TechSupport"]
    },
    "github": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-github"]
    }
  },

  "project_context": {
    "name": "NGD TechSupport",
    "type": "Android Mobile App with AI Chat",
    "path": "D:/Proyectos/APP/NGDStudios/NGD_TechSupport",
    "stack": ["Kotlin", "Firebase Firestore", "SQLite"]
  },

  "agent_definitions": {
    "supervisor": {
      "role": "Coordinador - Asigna tareas y revisa resultados",
      "can_delegate": true,
      "files": ["agents/supervisor.json"]
    },
    "android_dev_01": {
      "role": "Desarrollador Android Senior - Kotlin/Java",
      "files": ["agents/android_dev_01.json"]
    },
    "android_dev_02": {
      "role": "Desarrollador Android Jetpack",
      "files": ["agents/androd_dev_02.json"]
    },
    "backend": {
      "role": "Backend Firebase/APIs",
      "files": ["agents/backend.json"]
    },
    "ui": {
      "role": "UI/UX Design",
      "files": ["agents/ui.json"]
    },
    "support": {
      "role": "Soporte técnico",
      "files": ["agents/support.json"]
    },
    "qa": {
      "role": "QA Lead",
      "files": ["agents/qa.json"]
    },
    "qa_tester": {
      "role": "QA Tester",
      "files": ["agents/qa_tester.json"]
    },
    "security": {
      "role": "Seguridad",
      "files": ["agents/security.json"]
    },
    "performance": {
      "role": "Rendimiento/Optimización",
      "files": ["agents/perfomance.json"]
    },
    "devops": {
      "role": "Build/Deploy",
      "files": ["agents/devops.json"]
    },
    "documentation": {
      "role": "Documentación",
      "files": ["agents/documentation.json"]
    },
    "architect": {
      "role": "Arquitectura",
      "files": ["agents/architect.json"]
    }
  },

  "execution_config": {
    "use_opencode_task": true,
    "subagent_type": "general",
    "agents_dir": "agents"
  },

  "workflows": {
    "bug": ["supervisor", "support", "qa_tester", "android_dev_01", "backend", "qa", "devops"],
    "feature": ["supervisor", "architect", "android_dev_01", "android_dev_02", "backend", "qa", "devops"],
    "support": ["supervisor", "support", "qa_tester", "android_dev_01"],
    "optimization": ["supervisor", "performance", "android_dev_02", "backend", "qa"]
  },

  "rules": {
    "always_delegate": "El supervisor debe asignar TODAS las tareas a agentes",
    "no_direct_work": "No hacer trabajo directo a menos que sea necesario",
    "verify_build": "Verificar build con ./gradlew.bat assembleDebug después de cambios",
    "commit_after_fix": "Hacer commit después de cada fix exitoso"
  }
}